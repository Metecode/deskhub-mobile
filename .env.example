# Copy to .env and edit.

# Must match [hub] token in the companion's config.toml.
HUB_TOKEN=change-me

# Port for the companion (/ws), phones (/client) and the web app (/).
HUB_PORT=8765

# Required. Phones need it to see data and send commands: open
# http://<PC-IP>:8765/?token=<this> once. Generate one with:
#   node -p "crypto.randomBytes(16).toString('hex')"
CLIENT_TOKEN=

# Optional: where to show the weather for. Phones get it from Open-Meteo
# (https://open-meteo.com), which sees these coordinates; two decimals are
# plenty. Without them nothing is fetched.
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
# Only shown on the Weather page.
WEATHER_CITY=
# metric (°C, km/h) or imperial (°F, mph)
WEATHER_UNITS=metric

# Optional: more web origins that may connect, comma separated. This PC's own
# addresses and host name are always allowed, on HUB_PORT and on 5173 (Vite).
# CLIENT_ORIGINS=http://hub.lan:8765
CLIENT_ORIGINS=

# Optional: the morning bulletin (docs/setup.md). Codex CLI writes it on your
# ChatGPT plan, never with an API key. Without the prompt file there is none.
# BULLETIN_PROMPT_FILE=bulletin.prompt.md
# Not before this time (local), on the day's first opening.
# BULLETIN_FROM=06:00
# Only if Codex isn't found by itself (an .exe).
# CODEX_PATH=
# Where bulletins and measurements are kept; default
# %LOCALAPPDATA%\deskhub-mobile\data.
# DATA_DIR=

# Optional: the bulletin's portfolio from your Google Sheet, read-only, with a
# service account (docs/setup.md). The ID is the part of the sheet's link
# between /d/ and /edit. The key file is never committed.
# SHEETS_ID=
# SHEETS_KEY_FILE=google-service-account.json
# Only these tabs are read and given to Codex.
# SHEETS_TABS=Özet,Pozisyonlar,Alımlar,Altın Alımları,Kontrol

# Optional: weekly reminders, like reminders.example.json (never committed).
# REMINDERS_FILE=reminders.json
