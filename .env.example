# Copy to .env and edit.

# Must match [hub] token in the companion's config.toml (at most 63 bytes).
DESKHUB_TOKEN=change-me

# Port for the companion (/ws), the phone (/client) and the web app (/).
DESKHUB_PORT=8765

# Key the phone needs to connect: open http://<PC-IP>:8765/?key=<this> once.
# Generate one with: node -p "crypto.randomBytes(12).toString('hex')"
# Empty = anyone on your network can see the data and run your shortcuts.
DESKHUB_CLIENT_KEY=
