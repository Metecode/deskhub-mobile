{
  "name": "deskhub-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Use an old Android phone as the screen for Desk Hub (unofficial community client).",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" run dev",
    "build": "pnpm typecheck && pnpm --filter \"./apps/*\" run build",
    "start": "pnpm --filter @deskhub-mobile/bridge run start",
    "test": "vitest run",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
